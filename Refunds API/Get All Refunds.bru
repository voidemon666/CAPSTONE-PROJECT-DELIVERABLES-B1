meta {
  name: Get All Refunds
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/refunds
  body: json
  auth: bearer
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

auth:bearer {
  token: my-secret-token
}

body:json {
  {
    "amount": 500,
    "currency": "USD",
    "reason": "Product Return"
  }
  
}

settings {
  encodeUrl: true
  timeout: 0
}
